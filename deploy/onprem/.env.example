# Copy to deploy/onprem/.env and fill in real values.
# Never commit .env.

# ── Public edge ──────────────────────────────────────────────────
API_PUBLIC_HOST=api.hubonlewis.com

# Browser origins allowed to call this API (comma-separated, exact match)
CORS_ORIGINS=https://admin.hubonlewis.com,https://the-hub-qy8a.onrender.com,http://localhost:5173,http://127.0.0.1:5173
CLIENT_URL=https://admin.hubonlewis.com

# ── MongoDB (Atlas recommended; keep backups) ────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hub_crm?retryWrites=true&w=majority
DB_NAME=hub_crm

# ── Auth ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
SUPER_ADMIN_EMAILS=jason@hubonlewis.com,hannah@hubonlewis.com,jaden@hubonlewis.com

# ── Product ──────────────────────────────────────────────────────
HUB_PRODUCT_MODE=venue
NODE_ENV=production
PORT=3001

# ── Ollama on Hub LAN (always-on) ────────────────────────────────
# Same machine as Docker (Windows host Ollama):
AI_PROVIDER=local
AI_MODE=draft_only
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=llama3.2
AI_API_KEY=ollama
AI_TIMEOUT_MS=120000

# Different always-on box on the same LAN (example):
# AI_BASE_URL=http://192.168.1.50:11434/v1

# ── Optional bootstrap (only when users collection is empty) ─────
# SEED_ADMIN_EMAIL=jason@hubonlewis.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Jason Lavender
# SEED_ADMIN_ENTITY=HUB
# SEED_ADMIN_LOCATION=Wichita
# SEED_ADMIN_TENANT_ID=hub-wichita

# ── Attachments ──────────────────────────────────────────────────
ATTACHMENT_STORAGE_DRIVER=local
