# Paste into Render Dashboard → Environment → "Add from .env"
# Only these values require manual entry on first Blueprint deploy.
# All other variables are defined in render.yaml.

# REQUIRED — MongoDB Atlas (database name must match DB_NAME=hub_crm in URI path)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hub_crm?retryWrites=true&w=majority

# REQUIRED on first deploy — creates jason@hubonlewis.com when the users collection is empty
# Choose a strong password; share securely with the client for the demo login.
SEED_ADMIN_PASSWORD=

# OPTIONAL — Google Analytics 4 (web static site)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# OPTIONAL — Mailchimp lead sync (API service; no-ops when unset)
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=

# OPTIONAL — production URLs
# VITE_API_URL=https://api.hubonlewis.com/api
# CORS_ORIGINS=https://admin.hubonlewis.com,https://the-hub-qy8a.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# OPTIONAL — Local model PC bridge (OpenAI-compatible: Ollama / LM Studio)
# If API is on Render, AI_BASE_URL must be a public tunnel to the model PC (not a LAN IP).
# See docs/HUB_LOCAL_MODEL_LINK.md
# AI_PROVIDER=local
# AI_MODE=draft_only
# AI_BASE_URL=https://your-tunnel.example.com/v1
# AI_MODEL=llama3.2
# AI_API_KEY=ollama
# AI_TIMEOUT_MS=120000
# HUB_PRODUCT_MODE=venue

# OPTIONAL — Cloud model (SpaceXAI / xAI)
# AI_PROVIDER=xai
# AI_MODE=draft_only
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-4.5
# XAI_API_KEY=
